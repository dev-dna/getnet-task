# Provedor: anthropic | openrouter | claude_cli | fake
# claude_cli não precisa de chave: usa o Claude Code logado na máquina. Só fora do Docker: `make run-cli` e `make eval-cli`.
LLM_PROVIDER=openrouter

# --- openrouter ---
# Configuração conferida com chave real em 14/nov/2026: os dois papéis no Haiku passaram 30 de 30 casos
# (evals/report_openrouter.json), 56 chamadas e cerca de 1,4 centavo de dólar por rodada.
OPENROUTER_API_KEY=sk-or-v1-...
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_SMART=anthropic/claude-haiku-5.5
# Modelo principal maior: respostas mais cuidadas, cerca de 7 vezes o custo, e a conta precisa de crédito comprado
# (com a conta só na cortesia o OpenRouter recusou as chamadas com HTTP 402).
# MODEL_SMART=anthropic/claude-sonnet-5.5
# Outros fornecedores: confira o nome exato em openrouter.ai/models e rode `make smoke` antes de usar.

# --- anthropic direto ---
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_FAST=claude-haiku-5-5
# MODEL_SMART=claude-sonnet-5-5

# --- roteamento ---
# Quem decide quando o classificador local fica em dúvida: llm (o modelo de linguagem) ou jev (modelo de decisão da
# TypeSafe, mesma chave do OpenRouter). O padrão é llm porque o passo do Jev nunca foi chamado com chave real
# (README, seção 8); se o Jev falhar a decisão cai no modelo de linguagem de qualquer jeito.
ROUTER_FALLBACK=llm
# ROUTER_FALLBACK=jev
# JEV_MODEL=typesafe/jev-1.14
# JEV_MIN=0.5               # abaixo disso o Jev passa a decisão para o modelo de linguagem

# --- opcionais ---
# ROUTER_HIGH=0.7           # a partir dessa probabilidade o classificador roteia sem o modelo
# EMBEDDINGS=auto           # auto: baixa o modelo de vetores do roteador se faltar | cached: só se já baixado | off
# AWESOMEAPI_TOKEN=         # só para a reserva de câmbio
# LLM_TIMEOUT_S=40
# LLM_THINKING_ROOM=1500     # folga somada ao limite de saída: o raciocínio do modelo conta nesse limite. Com crédito comprado pode subir.
